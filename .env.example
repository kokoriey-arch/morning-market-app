# Server-only credentials. Never prefix these with EXPO_PUBLIC_.
TWELVE_DATA_API_KEY=replace-with-your-twelve-data-key
KIWOOM_APP_KEY=replace-with-your-kiwoom-app-key
KIWOOM_SECRET_KEY=replace-with-your-kiwoom-secret-key

# Backend binding and protection.
# Cloud PaaS platforms inject PORT automatically; MARKET_PROXY_HOST then
# defaults to 0.0.0.0. Set MARKET_PROXY_TOKEN whenever the proxy is not local.
MARKET_PROXY_HOST=127.0.0.1
MARKET_PROXY_PORT=8787
MARKET_PROXY_TOKEN=replace-with-a-long-random-token
MARKET_RATE_LIMIT=60
MARKET_ALLOWED_ORIGINS=http://localhost:8081
# Set to 1 only behind a reverse proxy that sets X-Forwarded-For.
MARKET_TRUST_PROXY=0

# Optional credit/cache tuning (see DEPLOYMENT.md).
# MARKET_PRICE_TTL_MS=180000
# MARKET_HISTORY_TTL_MS=600000
# MARKET_KIWOOM_TTL_MS=60000
# MARKET_DAILY_CREDIT_LIMIT=700

# Mobile app configuration. The URL is public, but must use HTTPS in production.
# ⚠️ EXPO_PUBLIC_* values are inlined at build time — a new eas build is required
# after any change. For production, set these in eas.json's production env
# (see eas.json) so the APK embeds the cloud URL instead of the emulator default.
# Local dev default: http://localhost:8787 (iOS sim / web) — do NOT ship this in an APK.
EXPO_PUBLIC_MARKET_API_URL=http://localhost:8787
# Bearer token sent by the app; must match MARKET_PROXY_TOKEN when the proxy
# runs on a cloud host. Note: EXPO_PUBLIC_* values are embedded in the app
# bundle, so treat this token as public and add real user auth before launch.
EXPO_PUBLIC_MARKET_API_TOKEN=
# Optional: exact Kiwoom code for the currently traded night-futures contract.
EXPO_PUBLIC_KIWOOM_NIGHT_FUTURES_CODE=

